# Porta do Servidor
PORT=3333

# --- MongoDB: conteudo das FAQs ---------------------------------------------
# Mesma base lida pelo chatbot e escrita pela ingestao Python. O nome do banco
# vem no caminho da URI.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ministerio_saude

# Chave da API do Gemini, usada para gerar o embedding de cada FAQ criada aqui.
# Precisa ser o MESMO modelo usado na ingestao e no fluxo do n8n, senao a
# pergunta e os documentos caem em espacos vetoriais diferentes.
GEMINI_API_KEY=AIzaSyA_sua_chave_do_gemini_aqui
# Modelo e task_type dos embeddings. Precisam ser IDENTICOS aos usados na
# ingestao (scripts/lib/gemini_embendding.py) e no no Embeddings do n8n.
# Divergir nao gera erro: a FAQ entra no banco e nunca aparece nas buscas.
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_TASK_TYPE=SEMANTIC_SIMILARITY

# --- Postgres: identidade ----------------------------------------------------
# Usuarios, papeis e sessoes. Nenhum conteudo de FAQ entra aqui.
# Em producao, acrescente ?sslmode=require e ligue DATABASE_SSL.
DATABASE_URL=postgresql://petsaude:senha@localhost:5432/petsaude
DATABASE_SSL=false
# Roda as migrations no boot. Util em producao; em dev prefira pnpm migration:run.
DB_RUN_MIGRATIONS=false

# --- Autenticacao ------------------------------------------------------------
# Assina os tokens. Trocar este valor derruba todas as sessoes ativas.
# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
# Vazio = so as locais. Em producao, a URL do front na Vercel.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=
# Validade do token em segundos (padrao: 8 horas).
JWT_EXPIRES_IN_SECONDS=28800

# --- Primeiro administrador (usado so pelo pnpm run seed:admin) --------------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Exclusao definitiva de FAQs ---------------------------------------------
# Quando true, FAQs desativadas ha mais de 7 dias sao apagadas de vez a cada
# 24h. FAQs criadas neste dashboard nao existem no Google Drive e NAO voltam
# numa reingestao. Deixe desligado a menos que saiba o que esta fazendo.
FAQ_PURGE_ENABLED=false
