# Infraestrutura Docker
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.

# Token do Cloudflare Tunnel (gerado no dashboard do Cloudflare)
CLOUDFLARE_TUNNEL_TOKEN=

# URL pública exposta pelo tunnel (ex: https://petbot.seudominio.dev)
CLOUDFLARE_URL=

# Chave de autenticação da API do WAHA (defina você mesmo, qualquer string segura)
WAHA_API_KEY=

# Credenciais do dashboard do WAHA
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Credenciais da interface Swagger do WAHA (pode usar os mesmos do dashboard)
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=
