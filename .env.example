# ============================================================================
# Infraestrutura do chatbot — copie para .env e preencha com valores reais.
# NUNCA commite o arquivo .env no repositório.
#
# Gere cada segredo com um valor aleatório distinto (PowerShell):
#   -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# ============================================================================

# --- Exposição pública (Cloudflare Tunnel) ---------------------------------
# Token do tunnel, gerado no dashboard do Cloudflare.
CLOUDFLARE_TUNNEL_TOKEN=
# URL pública exposta pelo tunnel (ex: https://petbot.seudominio.dev)
CLOUDFLARE_URL=

# --- Gateway de WhatsApp ----------------------------------------------------
# Chave que o n8n apresenta em `X-Api-Key` ao pedir o envio de mensagens.
# Substitui a antiga WAHA_API_KEY. Mínimo de 16 caracteres.
GATEWAY_API_KEY=
# URL do gateway na rede do compose (usada pelos nós HTTP do n8n).
GATEWAY_URL=http://whatsapp-gateway:3000

# Nome da sessão. Trocar este valor exige ler o QR code de novo.
WA_SESSION_ID=default
# Conecta a sessão automaticamente quando o container sobe.
WA_AUTO_START=true
# Marca as mensagens do cidadão como lidas antes de responder.
WA_MARK_AS_READ=true

# Política anti-ban: atraso aleatório entre envios e teto por minuto.
# Aumentar os atrasos reduz o risco de bloqueio; diminuir aumenta a vazão.
WA_SEND_MIN_DELAY_MS=1200
WA_SEND_MAX_DELAY_MS=3000
WA_MAX_MSG_PER_MINUTE=20
WA_MAX_TYPING_MS=4000

# --- Entrega de eventos ao n8n ---------------------------------------------
# Caminho do nó Webhook do fluxo do WhatsApp — o RAG determinístico de
# n8n/whatsapp-chatbot.json. O protótipo PWA tem fluxo e rota próprios, mais
# abaixo, para que um não interfira no outro.
N8N_WEBHOOK_URL=http://n8n:5678/webhook/whatsapp
# Validado pela credencial "Header Auth" do nó Webhook. Mínimo de 16 caracteres.
N8N_WEBHOOK_TOKEN=
# Segredo do HMAC enviado em `X-Signature-256`. Mínimo de 16 caracteres.
# O n8n ainda não valida a assinatura (previsto para a Fase 2), mas o gateway
# já a envia — assim, ligar a validação não exige mudar o backend.
N8N_WEBHOOK_SECRET=

# --- Redis ------------------------------------------------------------------
# Antes era o literal "default" com a porta 6379 aberta no host. Use valor forte.
REDIS_PASSWORD=

# --- Postgres (identidade do Dashboard-PetSaude) ----------------------------
# Banco de usuários, papéis e sessões do dashboard. As FAQs continuam no
# MongoDB Atlas — este banco NÃO guarda conteúdo de FAQ.
# Porta publicada no HOST. O padrao 5432 costuma estar ocupado por uma
# instalacao nativa do Postgres; nesse caso o container nao sobe e o erro fala
# em "socket forbidden", que nao parece conflito de porta.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=petsaude
POSTGRES_USER=petsaude
POSTGRES_PASSWORD=
# String de conexão usada pelo back/ do Dashboard-PetSaude, que roda fora deste
# compose. Em produção aponte para o Postgres gerenciado e acrescente
# ?sslmode=require.
DATABASE_URL=postgresql://petsaude:SENHA@localhost:5432/petsaude

# --- Dashboard de FAQs no compose (profile `dashboard`) ---------------------
# O dashboard vive em outro repositorio, clonado em Dashboard-PetSaude/. Os dois
# servicos ficam num profile para que `docker compose up -d` continue
# funcionando para quem nao tem essa pasta.
#
# Defina COMPOSE_PROFILES=dashboard para que o `up` normal ja inclua os dois.
COMPOSE_PROFILES=

# Assina os tokens do dashboard. Trocar derruba todas as sessoes ativas.
DASHBOARD_JWT_SECRET=
# Criptografa o cookie httpOnly que guarda o token no navegador.
DASHBOARD_SESSION_SECRET=
# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
DASHBOARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Portas publicadas no host. So mude em caso de conflito.
DASHBOARD_API_PORT=3333
DASHBOARD_FRONT_PORT=5173

# --- Protótipo PWA de validação ---------------------------------------------
# Interface web com cara de WhatsApp, para validar a qualidade das respostas com
# usuários reais sem precisar parear número. Ver docs/prototipo-pwa.md.
#
# É isolado do canal em produção de ponta a ponta: outro fluxo no n8n, outro
# token, outra credencial do Gemini e outro banco no Mongo.

# Porta publicada no host. Fica aberta na rede local (e não presa a 127.0.0.1)
# porque num teste presencial os celulares precisam alcançá-la.
PWA_PORT=8080

# Banco das conversas do protótipo, no MESMO cluster das FAQs. Separado de
# propósito: ao fim da validação, apagar tudo é um dropDatabase que não tem
# como levar FAQ junto.
PWA_MONGO_DB=pwa_prototipo

# Rota do fluxo n8n/pwa-chatbot.json. Token PRÓPRIO, validado por uma credencial
# Header Auth chamada "PWA Webhook Token" — separado do N8N_WEBHOOK_TOKEN para
# que rotacionar um canal não derrube o outro. Mínimo de 16 caracteres.
N8N_PWA_WEBHOOK_URL=http://n8n:5678/webhook/pwa-chat
N8N_PWA_WEBHOOK_TOKEN=

# Tempo máximo de espera pela resposta do fluxo. Ao contrário do WhatsApp, aqui
# a resposta volta na MESMA requisição e o participante está olhando a tela.
# PWA_N8N_TIMEOUT_MS=45000

# Vazia = tela de revisão (/admin) aberta, como decidido para o teste. Preencher
# passa a exigir usuário/senha (qualquer usuário, esta senha) sem mexer em
# código — útil se o link circular mais do que o previsto.
PWA_ADMIN_PASSWORD=

# --- Logs -------------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
N8N_LOG_LEVEL=info

# ============================================================================
# Cofre local — credenciais que o gateway NÃO lê.
# Os valores abaixo são digitados à mão nas credenciais do n8n (Settings →
# Credentials) e lidos pelos scripts Python de ingestão. O docker-compose.yml
# não repassa nenhum deles a nenhum container: aqui é só o lugar de guardar,
# para não ficarem soltos num bloco de notas.
#
# Eles vivem fora do repositório e fora do .env do gateway, então NÃO sobrevivem
# à troca de máquina: o volume `n8n_data` fica na máquina antiga. Guardar aqui é
# o que evita ter que caçá-los de novo na próxima migração.
# ============================================================================

# Connection string do MongoDB Atlas (Database → Connect → Drivers).
# Formato: mongodb+srv://USUARIO:SENHA@cluster.xxxxx.mongodb.net/
# Usada na credencial "MongoDB" do n8n e por scripts/*.py.
MONGODB_URI=

# Chave da API do Google Gemini (aistudio.google.com/apikey).
# Usada na credencial "Google Gemini" do n8n e por scripts/lib/gemini_embendding.py.
GEMINI_API_KEY=

# Chaves extras para rodízio na geração de embeddings. A cota gratuita é de
# 1000 requisições por dia POR PROJETO — duas chaves do mesmo projeto dividem o
# mesmo balde e rotacionar entre elas não adianta nada. Use projetos diferentes.
#
# A GEMINI_API_KEY_2 também alimenta a credencial "Gemini PWA" do n8n, usada
# pelo fluxo do protótipo. Isso só isola de verdade a cota do canal em produção
# se ela for de OUTRO projeto Google — sendo do mesmo, uma tarde de testes com
# participantes pode esgotar os 500 chats/dia e derrubar o bot do WhatsApp.
# Com quatro projetos, reindexar as ~2450 FAQs cabe numa única sessão.
# Quando uma chave devolve 429, os scripts pulam para a próxima sozinhos.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# Modelo e task_type usados na geração de embeddings. Precisam ser os MESMOS
# em três lugares — scripts de ingestão, dashboard e nó Embeddings do n8n —
# senão a pergunta e os documentos caem em espaços vetoriais diferentes e a
# busca devolve resultados aleatórios.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# GEMINI_TASK_TYPE=SEMANTIC_SIMILARITY

# --- Só para reexecutar a ingestão de FAQs (não é preciso na migração) ------
# A base do Atlas já está populada com ~1000 documentos e embeddings.
# ID da pasta do Google Drive com as planilhas de FAQ.
# ID_PASTA_DRIVE=
# Service account do Google, na raiz de scripts/. Já está no .gitignore.
# FILE_CREDENTIALS=credentials.json
# Teto de embeddings por execução dos scripts. Vazio ou 0 = sem teto, e quem
# interrompe é o 429 da própria API (os scripts param sozinhos e retomam de
# onde ficaram na execução seguinte). Só defina para limitar de propósito.
# LIMITE_EMBEDDINGS=0

# ============================================================================
# Ajustes finos. O compose repassa os três ao container, então defini-los aqui
# tem efeito. Comentados, valem os defaults mostrados.
# ============================================================================

# Tempo máximo de espera pela resposta do webhook do n8n.
# O fluxo responde só depois de consultar Gemini + MongoDB: se as execuções
# aparecerem como "erro de entrega" no log do gateway mas concluídas no n8n,
# este é o valor a aumentar.
# N8N_WEBHOOK_TIMEOUT_MS=10000
# Tentativas extras em caso de 5xx/429/timeout, com backoff exponencial.
# 4xx não é repetido — é contrato ou token errado, repetir só multiplica o erro.
# N8N_WEBHOOK_MAX_RETRIES=3

# Janela de deduplicação de mensagens recebidas (24h). O WhatsApp reentrega o
# mesmo id em reconexão; dentro desta janela a duplicata é descartada.
# DEDUPE_TTL_SECONDS=86400
