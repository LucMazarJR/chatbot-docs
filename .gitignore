# Credenciais e segredos
.env
# Pega variações como .env.local e .env.bak.waha. Só o exemplo é versionado.
.env.*
!.env.example
credentials.json
scripts/credentials.json

# ADS do Windows (NTFS) — não versionar
*:Zone.Identifier
**/*:Zone.Identifier
*Zone.Identifier
**/*Zone.Identifier

# Sidecars do Cursor
*.code.python
*.code.json

# Logs
*.log

# Node / backend
node_modules/
backend/dist/
backend/coverage/
backend/.sessions/
backend/.sessions-test/
*.tsbuildinfo

# Credenciais de sessão do WhatsApp: nunca versionar
.sessions/

# Python
__pycache__/
*.pyc
.venv/
scripts/__pycache__/
scripts/.venv/

# Arquivos Word temporários
*.docx
~$*.docx

# Backups das FAQs: podem conter a base inteira, incluindo embeddings
scripts/backups/

# Gabarito, cache e relatórios do teste de conversas: têm frases de cidadão
# ou texto derivado delas, e só existem na máquina de quem testa.
n8n/.local/

# Permissoes do Claude Code de cada maquina. Na VM082 ela bloqueia o acesso aos
# segredos (ver docs/servidor-vm082.md), e versionada valeria para todo mundo.
.claude/settings.local.json
