# Scripts de ingestão de FAQs
# Copie este arquivo para scripts/.env e preencha com os valores reais.
# NUNCA commite o arquivo .env no repositório.

# String de conexão do MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/database

# Chave da API do Google Gemini
GEMINI_API_KEY=

# ID da pasta do Google Drive com os arquivos .docx de FAQ
# (pegue da URL da pasta: drive.google.com/drive/folders/<ID>)
ID_PASTA_DRIVE=

# Caminho para o arquivo de credenciais da Conta de Serviço do Google
FILE_CREDENTIALS=credentials.json
